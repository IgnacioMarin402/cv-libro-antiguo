# Read by Cloudflare's static assets (see wrangler.jsonc), never served.
#
# On every page and file: no other site may frame the page — framed out of
# sight, a visitor's click could be steered onto the heart or the treat and
# counted as theirs. The browser takes each file as the type it's sent as.
# And another site the page links to is told where the visitor came from,
# not which page. The API sends the same, from worker/index.js.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite hashes everything under assets/ into its name, so those never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
